{
  "name": "@squid/agent-wallet-sdk",
  "version": "0.1.0",
  "description": "Squid Agent Wallet SDK — propose-only access to Squid Pay for AI agents (MCP + Platform API).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "squid",
    "agent",
    "wallet",
    "mcp",
    "payments",
    "propose-only"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/squid-pay/agent-wallet-sdk"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2"
  }
}
